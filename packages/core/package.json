{
  "name": "propfirm-calc",
  "version": "0.3.0",
  "description": "Drawdown, consistency, payout and import math for prop firm futures accounts, with an open firm-rules catalog.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shootingallday/propfirm-calc.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "propfirm-calc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "catalog"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalog:check": "tsx scripts/check-catalog.ts"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
